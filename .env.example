# 复制为 .env 并填值。.env 已被 .gitignore 忽略,永不提交。
# 用编辑器粘贴机密值,别用 echo(会留在 shell 历史)。
# 部署到 Render 时,这些填在 Render 的 Environment 界面,而不是提交进仓库。

# ── 测试网默认(本地验证)──────────────
X402_NETWORK=eip155:84532
PAY_TO=0x4b5887B6E399C2E104becd01f7c406229c15891d
PRICE=$0.001

# ── 上主网 + 挂 Bazaar(改/填这些)──────────────
# X402_NETWORK=eip155:8453
# PRICE=$0.01
# CDP_API_KEY_ID=你的 Key ID
# CDP_API_KEY_SECRET=你的 Secret
